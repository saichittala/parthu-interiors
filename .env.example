# ==============================================================================
# PARTHU INTERIORS — SANITY CMS & PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Sanity Content Lake & Studio Configuration
# Retrieve these from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-01

# Sanity API Tokens (Required for server-side private previews and migration scripts)
# Generate under Project -> API -> Tokens (Viewer token for READ, Editor token for WRITE)
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Production Domain & Canonical URL
NEXT_PUBLIC_SITE_URL=https://parthuinteriors.in

# Optional Google Sheet Webhook URL for Consultation Form Fallback
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_BLOGS_URL=

